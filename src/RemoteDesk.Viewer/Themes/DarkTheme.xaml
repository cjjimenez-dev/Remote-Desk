<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Emil Kowalski Design System - Dark Theme -->

    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="CanvasBgBrush" Color="#09090B"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#16161B"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#202026"/>
    <SolidColorBrush x:Key="CardSecondaryBgBrush" Color="#1A1A20"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#141418"/>
    <SolidColorBrush x:Key="InsetBgBrush" Color="#16161B"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#181820"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="#121216"/>
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#202026"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#323240"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="BorderCardBrush" Color="#2F2F3B"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#3F3F4E"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#38BDF8"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A"/>
    <SolidColorBrush x:Key="TextAddressBrush" Color="#FFFFFF"/>

    <!-- Semantic & Brand Accents -->
    <SolidColorBrush x:Key="BrandRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrandRedHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrandRedPressedBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="BrandRedBorderBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="BrandEmeraldBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="BrandEmeraldBgBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="BrandEmeraldBorderBrush" Color="#059669"/>
    <SolidColorBrush x:Key="BrandEmeraldTextBrush" Color="#34D399"/>

    <SolidColorBrush x:Key="BrandSkyBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="BrandSkyHoverBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="BrandSkyBgBrush" Color="#0C2A4D"/>
    <SolidColorBrush x:Key="BrandSkyBorderBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="BrandSkyTextBrush" Color="#E0F2FE"/>

    <!-- Header Button (Dark) -->
    <Style x:Key="EmilHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="#18181D"/>
        <Setter Property="Foreground" Value="#E4E4E7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2A2A34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#22222A"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#3F3F4E"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#141418"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#22222A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Sky Button -->
    <Style x:Key="EmilAccentButton" TargetType="Button" BasedOn="{StaticResource EmilHeaderButton}">
        <Setter Property="Background" Value="#0284C7"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#075985"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Connect Emerald Button -->
    <Style x:Key="EmilConnectButton" TargetType="Button">
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#34D399"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#047857"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#6EE7B7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#065F46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AnyDesk Signature Red Button Style -->
    <Style x:Key="AnyDeskRedButton" TargetType="Button">
        <Setter Property="Background" Value="#EF4444"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#F87171"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#FCA5A5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EmilCard" TargetType="Border">
        <Setter Property="Background" Value="#202026"/>
        <Setter Property="BorderBrush" Value="#2F2F3B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Default TextBox Style (Clean Dark Inset) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#141418"/>
        <Setter Property="Foreground" Value="#F4F4F5"/>
        <Setter Property="BorderBrush" Value="#2F2F3B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="#38BDF8"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Default CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#A1A1AA"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
