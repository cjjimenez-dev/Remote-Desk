<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Emil Kowalski Design System - Light Theme (Default) -->

    <!-- Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="CanvasBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardSecondaryBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="InsetBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="StatusBarBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="#E2E8F0"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderCardBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#0284C7"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextAddressBrush" Color="#0F172A"/>

    <!-- Semantic & Brand Accents -->
    <SolidColorBrush x:Key="BrandRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="BrandRedHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrandRedPressedBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="BrandRedBorderBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="BrandEmeraldBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="BrandEmeraldBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="BrandEmeraldBorderBrush" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="BrandEmeraldTextBrush" Color="#047857"/>

    <SolidColorBrush x:Key="BrandSkyBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="BrandSkyHoverBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="BrandSkyBgBrush" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="BrandSkyBorderBrush" Color="#BAE6FD"/>
    <SolidColorBrush x:Key="BrandSkyTextBrush" Color="#0369A1"/>

    <!-- Header Button (Light) -->
    <Style x:Key="EmilHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Sky Button -->
    <Style x:Key="EmilAccentButton" TargetType="Button" BasedOn="{StaticResource EmilHeaderButton}">
        <Setter Property="Background" Value="#0284C7"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#0369A1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#075985"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#075985"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Connect Emerald Button -->
    <Style x:Key="EmilConnectButton" TargetType="Button">
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#047857"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#047857"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#065F46"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#065F46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AnyDesk Signature Red Button Style -->
    <Style x:Key="AnyDeskRedButton" TargetType="Button">
        <Setter Property="Background" Value="#EF4444"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#DC2626"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EmilCard" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Default TextBox Style (Clean Emil Inset) -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="#0F172A"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Default CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
