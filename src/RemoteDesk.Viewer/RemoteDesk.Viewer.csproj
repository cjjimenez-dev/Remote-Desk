<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>RemoteDesk.Viewer.App</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesk.Core\RemoteDesk.Core.csproj" />
    <ProjectReference Include="..\RemoteDesk.Platform.Windows\RemoteDesk.Platform.Windows.csproj" />
    <ProjectReference Include="..\RemoteDesk.Server.Signaling\RemoteDesk.Server.Signaling.csproj" />
    <ProjectReference Include="..\RemoteDesk.Server.Api\RemoteDesk.Server.Api.csproj" />
    <ProjectReference Include="..\RemoteDesk.Transport.WebRtc\RemoteDesk.Transport.WebRtc.csproj" />
    <ProjectReference Include="..\RemoteDesk.Updater\RemoteDesk.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" />
  </ItemGroup>

</Project>
