<Window x:Class="RemoteDesk.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteDesk.Viewer.ViewModels"
        mc:Ignorable="d"
        Title="RemoteDesk Viewer - Phase 9 Fleet Dashboard"
        Height="850" Width="1350"
        Background="#18181B"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewKeyUp="OnWindowKeyUp"
        PreviewTextInput="OnWindowTextInput">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Connection Bar -->
        <Border Grid.Row="0" Background="#27272A" Padding="12,8" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- Left: Branding & Remote Host Connection Controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="RemoteDesk" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Border Background="#374151" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Phase 9: Fleet Dashboard" FontSize="11" Foreground="#9CA3AF"/>
                    </Border>

                    <!-- My Local Device ID Display -->
                    <TextBlock Text="My ID:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding LocalDeviceId}" FontFamily="Consolas" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Remote Host ID Input -->
                    <TextBlock Text="Host ID:" Foreground="#E5E7EB" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding TargetHostId, UpdateSourceTrigger=PropertyChanged}" 
                             Width="100" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                             Background="#18181B" Foreground="#38BDF8" BorderBrush="#4B5563" Margin="0,0,6,0"/>

                    <!-- Connect / Disconnect Button -->
                    <Button Command="{Binding ConnectRemoteCommand}" 
                            Height="28" Padding="12,2" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#16A34A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Content" Value="⚡ Connect"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Background" Value="#D97706"/>
                                        <Setter Property="Content" Value="Connecting..."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRemoteSessionActive}" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="Content" Value="❌ Disconnect"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Address Book Quick Button -->
                    <Button Command="{Binding ToggleAddressBookCommand}" 
                            Content="📖 Saved PCs" Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#374151" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>

                    <!-- Fleet Dashboard Button -->
                    <Button Command="{Binding ToggleFleetDashboardCommand}" 
                            Content="🏢 Fleet" Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                    <!-- Force TURN Relay Mode Checkbox -->
                    <CheckBox IsChecked="{Binding ForceRelay}" Content="Force Relay" 
                              Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Forces WebRTC traffic through TURN relay"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="#3F3F46" Margin="0,0,10,0"/>

                    <!-- Phase 7 In-Session Controls (Active when connected) -->
                    <!-- Remote Display Selection -->
                    <TextBlock Text="Monitor:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding RemoteDisplays}" 
                              SelectedItem="{Binding SelectedRemoteDisplay}" 
                              DisplayMemberPath="DeviceName"
                              Width="110" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Adaptive Quality Preset Selector -->
                    <TextBlock Text="Quality:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding AvailableQualityPresets}" 
                              SelectedItem="{Binding SelectedQualityPreset}" 
                              Width="95" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Audio Toggle Button -->
                    <Button Command="{Binding ToggleAudioMuteCommand}" 
                            Content="{Binding AudioButtonText}" 
                            Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#374151" Foreground="#E5E7EB" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>

                    <!-- File Transfer Button -->
                    <Button Command="{Binding SendFilePromptCommand}" 
                            Content="📁 Send File" 
                            Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>

                    <!-- In-Session Chat Button with Unread Badge -->
                    <Button Command="{Binding ToggleChatPaneCommand}" 
                            Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬 Chat"/>
                            <TextBlock Text="{Binding UnreadChatBadgeText}" FontWeight="Bold" Foreground="#FDE047"/>
                        </StackPanel>
                    </Button>

                    <!-- Remote Terminal Button -->
                    <Button Command="{Binding ToggleTerminalPaneCommand}" 
                            Content="💻 Terminal" 
                            Height="28" Padding="8,2" FontWeight="SemiBold"
                            Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Right: Local Loopback & Status Indicator -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleLoopbackCommand}" 
                            Height="28" Padding="8,2" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Content" Value="▶ Loopback"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoopbackActive}" Value="True">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Setter Property="Content" Value="⏹ Stop"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CursorPositionText}" FontSize="11" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- File Transfer Progress Banner -->
        <Border Grid.Row="1" Background="#1E3A8A" Padding="12,6"
                Visibility="{Binding IsFileTransferActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding CancelFileTransferCommand}" 
                        Content="Cancel" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,2" Cursor="Hand" Margin="8,0,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁 FILE TRANSFER: " FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FileTransferStatusText}" Foreground="#DBEAFE" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ProgressBar Value="{Binding FileTransferProgressPercent}" Minimum="0" Maximum="100" Width="180" Height="14" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Emergency Kill Switch Alert Banner -->
        <Border Grid.Row="2" Background="#7F1D1D" Padding="12,6" 
                Visibility="{Binding IsEmergencyKillTriggered, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding ResetEmergencyKillCommand}" 
                        Content="Resume Input" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,2" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ EMERGENCY KILL TRIGGERED: " FontWeight="Bold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                    <TextBlock Text="Input injection was killed by host user via hotkey (Ctrl+Alt+Shift+Esc)." Foreground="#FEE2E2" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video Display Canvas & Side Panels -->
        <Grid Grid.Row="3" Background="#09090B" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Video Center Area -->
            <Grid Grid.Column="0">
                <Image x:Name="VideoImageControl"
                       Source="{Binding VideoImage}" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseDown="OnVideoMouseDown"
                       MouseUp="OnVideoMouseUp"
                       MouseMove="OnVideoMouseMove"
                       MouseWheel="OnVideoMouseWheel"/>

                <!-- Placeholder when inactive -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToInverseVisibilityConverter.Instance}}">
                    <TextBlock Text="🌐" FontSize="56" HorizontalAlignment="Center" Foreground="#4B5563" Margin="0,0,0,12"/>
                    <TextBlock Text="No Active Remote Desktop Session" FontSize="20" FontWeight="SemiBold" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Enter a Target Host ID and click 'Connect' to start a session, or click 'Saved PCs' to select from your Address Book." FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Floating Stats HUD Overlay (Top Right) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="16" Background="#CC18181B" BorderBrush="#3F3F46" BorderThickness="1" 
                        CornerRadius="8" Padding="12,10"
                        Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="REAL-TIME METRICS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                        
                        <!-- Badges Row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{Binding SecurityStatusColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SecurityStatusBadge}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                            </Border>

                            <Border Background="{Binding ConnectionPathColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ConnectionPathBadge}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                            </Border>

                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding FpsText}" FontWeight="Bold" Foreground="#34D399" FontSize="12"/>
                            </Border>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding LatencyText}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12"/>
                            </Border>
                            <Border Background="#4C1D95" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding BitrateText}" FontWeight="Bold" Foreground="#C084FC" FontSize="12"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Permissions: " Foreground="#9CA3AF" FontSize="11"/>
                            <TextBlock Text="{Binding GrantedPermissionsText}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Timings: " Foreground="#9CA3AF" FontSize="11"/>
                            <TextBlock Text="{Binding EncodeDecodeText}" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Resolution: " Foreground="#9CA3AF" FontSize="11"/>
                            <TextBlock Text="{Binding ResolutionText}" Foreground="#E5E7EB" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- In-Session Chat Side Panel -->
            <Border Grid.Column="1" Width="320" Background="#1F2937" BorderBrush="#374151" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsChatPaneOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="#111827" Padding="12,10" BorderBrush="#374151" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleChatPaneCommand}" 
                                    Content="✕" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock Text="💬 In-Session Chat" FontWeight="Bold" Foreground="#F3F4F6" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Chat Message List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#374151" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel Orientation="Vertical">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimestampUtc, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="#9CA3AF"/>
                                                <TextBlock Text="{Binding SenderName}" FontWeight="Bold" Foreground="#60A5FA" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#F9FAFB" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chat Input Box & Send Button -->
                    <Border Grid.Row="2" Background="#111827" Padding="10" BorderBrush="#374151" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#1F2937" Foreground="White" BorderBrush="#4B5563" Padding="6,4" FontSize="12" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Command="{Binding SendChatMessageCommand}" 
                                    Content="Send" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Remote Terminal Drawer (Collapsible bottom/overlay panel) -->
            <Border Grid.ColumnSpan="2" Background="#F00F172A" BorderBrush="#334155" BorderThickness="0,2,0,0"
                    Height="340" VerticalAlignment="Bottom"
                    Visibility="{Binding IsTerminalOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Header -->
                    <Border Grid.Row="0" Background="#1E293B" Padding="10,6" BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding ClearTerminalOutputCommand}" 
                                        Content="Clear" Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" Padding="8,2" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Command="{Binding ToggleTerminalPaneCommand}" 
                                        Content="✕" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💻 Remote Terminal (ConPTY)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                
                                <TextBlock Text="Shell:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableShells}" 
                                          SelectedItem="{Binding SelectedShellType}" 
                                          Width="110" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <Button Command="{Binding StartTerminalSessionCommand}" 
                                        Content="▶ Start" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="10,2" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Command="{Binding CloseTerminalSessionCommand}" 
                                        Content="⏹ Stop" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,2" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Terminal Output Screen -->
                    <ScrollViewer Grid.Row="1" Background="#0F172A" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding TerminalOutputText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="Transparent" 
                                 Foreground="#38BDF8" 
                                 FontFamily="Consolas" 
                                 FontSize="13" 
                                 BorderThickness="0" 
                                 Padding="10" 
                                 TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- Terminal Input Bar -->
                    <Border Grid.Row="2" Background="#1E293B" Padding="8" BorderBrush="#334155" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PS &gt; " Foreground="#4ADE80" FontFamily="Consolas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="4,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TerminalInputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0F172A" Foreground="White" BorderBrush="#475569" FontFamily="Consolas" FontSize="13" Padding="6,4" Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendTerminalInputCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Command="{Binding SendTerminalInputCommand}" 
                                    Content="Enter" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="14,4" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Address Book Overlay Drawer -->
            <Border Grid.ColumnSpan="2" Background="#D0000000" 
                    Visibility="{Binding IsAddressBookOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="500" Height="480" Background="#1F2937" BorderBrush="#4B5563" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleAddressBookCommand}" 
                                    Content="✕" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <TextBlock Text="📖 Saved PCs &amp; Address Book" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- List of Entries -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AddressBookEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ToggleFavoriteAddressBookCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding DeviceId}"
                                                            Content="⭐" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                                    <Button Command="{Binding DataContext.SelectAddressBookEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="Select" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="8,2" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                                    <Button Command="{Binding DataContext.DeleteAddressBookEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding DeviceId}"
                                                            Content="🗑️" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Alias}" FontWeight="Bold" Foreground="#60A5FA" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" Foreground="#A78BFA" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LastConnectedUtc, StringFormat='Last connected: {0:yyyy-MM-dd HH:mm}'}" 
                                                               Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer -->
                        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding SaveCurrentHostToAddressBookCommand}" 
                                    Content="+ Save Current Host ID" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="{Binding AddressBookEntries.Count, StringFormat='Total saved: {0}'}" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Fleet Dashboard Overlay Drawer -->
            <Border Grid.ColumnSpan="2" Background="#E0000000" 
                    Visibility="{Binding IsFleetDashboardOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="980" Height="640" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleFleetDashboardCommand}" 
                                    Content="✕" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏢 Fleet Management &amp; Inventory" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="#0284C7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Live Inventory" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Metric Summary Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total Hosts" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding FleetSummary.TotalDevices}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="🟢 Online" FontSize="11" Foreground="#34D399"/>
                                    <TextBlock Text="{Binding FleetSummary.OnlineDevices}" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="🔵 In Session" FontSize="11" Foreground="#60A5FA"/>
                                    <TextBlock Text="{Binding FleetSummary.InSessionDevices}" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="⚪ Offline" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding FleetSummary.OfflineDevices}" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Search & Filter Controls -->
                        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="All" 
                                            Content="All" Padding="8,3" FontSize="11" FontWeight="Bold" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="Online" 
                                            Content="Online" Padding="8,3" FontSize="11" FontWeight="Bold" Background="#065F46" Foreground="#34D399" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="InSession" 
                                            Content="In Session" Padding="8,3" FontSize="11" FontWeight="Bold" Background="#1E40AF" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="Offline" 
                                            Content="Offline" Padding="8,3" FontSize="11" FontWeight="Bold" Background="#374151" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                                    <Button Command="{Binding RefreshFleetDataCommand}" 
                                            Content="🔄 Refresh" Padding="10,3" FontSize="11" FontWeight="Bold" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>

                                <TextBox Text="{Binding FleetSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#1E293B" Foreground="White" BorderBrush="#475569" Padding="6,4" FontSize="12" Margin="0,0,10,0"/>
                            </DockPanel>
                        </Border>

                        <!-- Devices Table -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FleetDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel LastChildFill="True">
                                                <!-- Action Buttons on Right -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ConnectToFleetDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="⚡ Connect" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.LaunchFleetDeviceTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="💻 Terminal" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.SendFleetLockCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="🔒 Lock" Background="#334155" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Padding="6,3" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.SendFleetRebootCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="🔄 Reboot" Background="#991B1B" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="11" Padding="6,3" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>

                                                <!-- Device Details on Left -->
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Hostname}" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding IpAddress}" FontFamily="Consolas" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding OperatingSystem}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding MemoryDisplay, StringFormat='RAM: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding CpuModel}" Foreground="#64748B" FontSize="10" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding LastHeartbeatUtc, StringFormat='Last seen: {0:HH:mm:ss}'}" Foreground="#64748B" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer -->
                        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
                            <TextBlock Text="{Binding FleetDevices.Count, StringFormat='Total devices matching filter: {0}'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="#18181B" Padding="12,6" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding StatusText}" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
