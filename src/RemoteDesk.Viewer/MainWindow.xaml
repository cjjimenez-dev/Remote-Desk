<Window x:Class="RemoteDesk.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteDesk.Viewer.ViewModels"
        mc:Ignorable="d"
        Title="RemoteDesk"
        Icon="assets/icon.ico"
        Height="620" Width="960"
        MinHeight="500" MinWidth="780"
        WindowState="Normal"
        Background="{DynamicResource CanvasBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        PreviewKeyDown="OnWindowKeyDown"
        PreviewKeyUp="OnWindowKeyUp"
        PreviewTextInput="OnWindowTextInput">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Tab Header Bar (AnyDesk Style) -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" Padding="14,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- Left: App Icon & AnyDesk Tabs -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Brand Icon -->
                    <Border CornerRadius="6" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="2" Margin="0,0,8,0">
                        <Image Source="assets/logo-64.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="RemoteDesk" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- AnyDesk Active Tab -->
                    <Border Background="{DynamicResource TabActiveBgBrush}" BorderBrush="{DynamicResource TabActiveBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Connection" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- In-Session Controls (Only visible during active session) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                        <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Disconnect Button (AnyDesk Red) -->
                        <Button Command="{Binding DisconnectRemoteCommand}" 
                                Content="❌ Disconnect" Style="{DynamicResource AnyDeskRedButton}" Height="26" Padding="10,0" Margin="0,0,8,0"/>

                        <TextBlock Text="Monitor:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding RemoteDisplays}" 
                                  SelectedItem="{Binding SelectedRemoteDisplay}" 
                                  DisplayMemberPath="DeviceName"
                                  Width="90" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>

                        <TextBlock Text="Quality:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding AvailableQualityPresets}" 
                                  SelectedItem="{Binding SelectedQualityPreset}" 
                                  Width="80" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>

                        <Button Command="{Binding ToggleAudioMuteCommand}" 
                                Style="{DynamicResource EmilHeaderButton}"
                                Content="{Binding AudioButtonText}" Height="24" Margin="0,0,6,0"/>

                        <Button Command="{Binding SendFilePromptCommand}" 
                                Style="{DynamicResource EmilHeaderButton}"
                                Content="📁 File" Height="24" Margin="0,0,6,0"/>

                        <Button Command="{Binding ToggleChatPaneCommand}" 
                                Style="{DynamicResource EmilHeaderButton}" Height="24" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬 Chat"/>
                                <TextBlock Text="{Binding UnreadChatBadgeText}" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleTerminalPaneCommand}" 
                                Style="{DynamicResource EmilHeaderButton}"
                                Content="💻 Terminal" Height="24" Margin="0,0,6,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Utilities (Theme Toggle, Internet Tunnel, Server Host, Address Book, Fleet, Loopback) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Light / Dark Theme Toggle Button -->
                    <Button Command="{Binding ToggleThemeCommand}" 
                            Content="{Binding ThemeToggleIcon}" 
                            ToolTip="{Binding ThemeToggleTooltip}" 
                            Style="{DynamicResource EmilHeaderButton}" 
                            Height="26" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Built-in Cloudflare Internet Tunnel Button (Dynamic Theme Safe) -->
                    <Button Command="{Binding ToggleCloudflareTunnelCommand}"
                            Content="{Binding TunnelButtonText}"
                            ToolTip="{Binding TunnelButtonTooltip}"
                            Style="{DynamicResource EmilHeaderButton}"
                            Visibility="{Binding IsCloudflareTunnelActive, Converter={x:Static vm:BooleanToInverseVisibilityConverter.Instance}}"
                            Height="26" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding ToggleCloudflareTunnelCommand}"
                            Content="{Binding TunnelButtonText}"
                            ToolTip="{Binding TunnelButtonTooltip}"
                            Style="{DynamicResource EmilConnectButton}"
                            Visibility="{Binding IsCloudflareTunnelActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                            Height="26" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Advanced Network Settings Toggle -->
                    <Button Command="{Binding ToggleAdvancedSettingsCommand}" 
                            Style="{DynamicResource EmilHeaderButton}"
                            Content="⚙ Network" Height="26" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Custom Server &amp; Advanced Network Settings"/>

                    <Button Command="{Binding ToggleAddressBookCommand}" 
                            Style="{DynamicResource EmilHeaderButton}"
                            Content="📖 Saved" Margin="0,0,6,0" ToolTip="Address Book / Saved Desktops"/>

                    <Button Command="{Binding ToggleFleetDashboardCommand}" 
                            Style="{DynamicResource EmilAccentButton}"
                            Content="🏢 Fleet" Margin="0,0,8,0" ToolTip="Fleet Management Dashboard"/>

                    <Button Command="{Binding ToggleLoopbackCommand}" 
                            Style="{DynamicResource EmilHeaderButton}"
                            Content="▶ Loopback"
                            Visibility="{Binding IsLoopbackActive, Converter={x:Static vm:BooleanToInverseVisibilityConverter.Instance}}"
                            Margin="0,0,8,0"/>
                    <Button Command="{Binding ToggleLoopbackCommand}" 
                            Style="{DynamicResource AnyDeskRedButton}"
                            Content="⏹ Stop"
                            Visibility="{Binding IsLoopbackActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                            Height="26" Padding="10,0" Margin="0,0,8,0"/>

                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                            Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding CursorPositionText}" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="{DynamicResource BrandSkyTextBrush}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <!-- Advanced Network Settings Drawer (Collapsed by default - Clean AnyDesk experience) -->
            <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,6"
                    Visibility="{Binding IsAdvancedSettingsVisible, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding ForceRelay}" Content="Force Relay (TURN only)" 
                                  Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                                  ToolTip="Keep UNCHECKED for fast direct P2P. Only check if behind a restrictive corporate firewall."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Custom Server:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SignalingHostInput, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="220" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                 FontFamily="Consolas, Cascadia Code" FontSize="11"
                                 Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderFocusBrush}" BorderThickness="1" Padding="6,0"
                                 ToolTip="Enter localhost, LAN IP (e.g. 192.168.1.50), VPS IP:5000, or Cloudflare Tunnel">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ApplySignalingServerChangeCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Command="{Binding ApplySignalingServerChangeCommand}" Content="✓ Apply" Style="{DynamicResource EmilAccentButton}" Height="24" Padding="10,0" Margin="6,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Incoming Connection Prompt Banner (When someone requests to connect to This Desk) -->
            <Border Background="{DynamicResource BrandSkyBgBrush}" BorderBrush="{DynamicResource BrandSkyBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,8"
                    Visibility="{Binding IsIncomingPromptVisible, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AcceptIncomingConnectionCommand}" 
                                Content="✔ Accept Connection" Style="{DynamicResource EmilConnectButton}" Height="28" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Command="{Binding RejectIncomingConnectionCommand}" 
                                Content="✕ Reject" Style="{DynamicResource AnyDeskRedButton}" Height="28" Padding="12,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔔 INCOMING DESKTOP ACCESS REQUEST: " FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding IncomingPromptText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <!-- LAN Peer Discovered Banner (Automatic Wi-Fi / Local Network Sync) -->
            <Border Background="{DynamicResource BrandSkyBgBrush}" BorderBrush="{DynamicResource BrandSkyBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,6"
                    Visibility="{Binding IsLanPeerDiscovered, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding UseDiscoveredLanServerCommand}" 
                                Content="⚡ Connect to this LAN PC" Style="{DynamicResource EmilConnectButton}" Height="26" Padding="12,0" Margin="0,0,8,0"/>
                        <Button Command="{Binding DismissLanDiscoveryBannerCommand}" 
                                Content="✕" Background="Transparent" Foreground="{DynamicResource BrandSkyTextBrush}" BorderThickness="0" Cursor="Hand" Padding="4,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DiscoveredPeerText}" FontWeight="SemiBold" Foreground="{DynamicResource BrandSkyTextBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Active Incoming Session Banner (When This Desk is currently streaming to a remote partner) -->
            <Border Background="#3B0764" BorderBrush="#7E22CE" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,8"
                    Visibility="{Binding IsServingIncomingSession, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding StopSharingDesktopCommand}" 
                            Content="⏹ Disconnect Remote User" Style="{DynamicResource AnyDeskRedButton}" Height="28" Padding="12,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IncomingSessionText}" FontWeight="Bold" Foreground="#F0ABFC" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Update Available Notification Banner (Emil Floating Pill Style) -->
        <Border Grid.Row="3" Background="{DynamicResource BrandEmeraldBgBrush}" BorderBrush="{DynamicResource BrandEmeraldBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,8"
                Visibility="{Binding IsUpdateAvailable, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding DownloadAndApplyUpdateCommand}" 
                            Content="⚡ Update Now" Style="{DynamicResource EmilConnectButton}" Height="28" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Command="{Binding DismissUpdateBannerCommand}" 
                            Content="✕ Dismiss" Background="Transparent" Foreground="{DynamicResource BrandEmeraldTextBrush}" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 UPDATE AVAILABLE: " FontWeight="Bold" Foreground="{DynamicResource BrandEmeraldTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding UpdateVersionText, StringFormat='v{0}'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding UpdateReleaseNotes}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar Value="{Binding UpdateDownloadProgress}" Minimum="0" Maximum="100" Width="100" Height="8" VerticalAlignment="Center"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"/>
                    <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="{DynamicResource BrandSkyTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- File Transfer Progress Banner -->
        <Border Grid.Row="4" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,6"
                Visibility="{Binding IsFileTransferActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding CancelFileTransferCommand}" 
                        Content="Cancel" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,2" Cursor="Hand" Margin="8,0,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁 FILE TRANSFER: " FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FileTransferStatusText}" Foreground="#DBEAFE" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ProgressBar Value="{Binding FileTransferProgressPercent}" Minimum="0" Maximum="100" Width="180" Height="10" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Emergency Kill Switch Alert Banner -->
        <Border Grid.Row="5" Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Margin="14,8,14,0" Padding="12,6"
                Visibility="{Binding IsEmergencyKillTriggered, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Command="{Binding ResetEmergencyKillCommand}" 
                        Content="Resume Input" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="10,2" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ EMERGENCY KILL TRIGGERED: " FontWeight="Bold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                    <TextBlock Text="Input injection was killed by host user via hotkey (Ctrl+Alt+Shift+Esc)." Foreground="#FEE2E2" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video Display Canvas & Side Panels -->
        <Grid Grid.Row="6" Background="{DynamicResource CanvasBgBrush}" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Video Center Area -->
            <Grid Grid.Column="0" AllowDrop="True"
                  DragOver="OnVideoDragOver" DragLeave="OnVideoDragLeave" Drop="OnVideoDrop">
                <Image x:Name="VideoImageControl"
                       Source="{Binding VideoImage}" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseDown="OnVideoMouseDown"
                       MouseUp="OnVideoMouseUp"
                       MouseMove="OnVideoMouseMove"
                       MouseWheel="OnVideoMouseWheel"/>

                <!-- Drag and Drop File Transfer Visual Target Overlay -->
                <Border Background="#E6090D16" BorderBrush="#38BDF8" BorderThickness="2"
                        CornerRadius="14" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,28"
                        Visibility="{Binding IsDragOverRemoteScreen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="2" Color="#0284C7" Opacity="0.5"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Drop files here to transfer to remote desktop" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Files will be saved to Downloads/RemoteDesk" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- AnyDesk Official Design Dashboard (When no session is active) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToInverseVisibilityConverter.Instance}}"
                              Padding="24,18">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="880">
                        
                        <!-- Top Two Hero Cards: This Desk & Remote Desk -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: This Desk (AnyDesk Signature) -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="🖥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="This Desk" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource BrandEmeraldBgBrush}" BorderBrush="{DynamicResource BrandEmeraldBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrandEmeraldBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ready" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandEmeraldTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <TextBlock Text="Your Address" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    
                                    <!-- Spaced Address Box with One-Click Copy -->
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Command="{Binding CopyDeviceIdCommand}" 
                                                    Style="{DynamicResource EmilHeaderButton}" Height="30" Padding="10,0" ToolTip="{Binding CopiedTooltipText}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋 " FontSize="11"/>
                                                    <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding LocalDeviceId}" FontFamily="Consolas, Cascadia Code, Segoe UI" 
                                                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextAddressBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Your Local IP Address Capsule -->
                                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="Your Local IP:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding LocalLanIp}" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Internet Tunnel Address Capsule (When Cloudflare Tunnel is Active) -->
                                    <Border Background="{DynamicResource BrandSkyBgBrush}" BorderBrush="{DynamicResource BrandSkyBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                                            Visibility="{Binding IsCloudflareTunnelActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Command="{Binding CopyInternetAddressCommand}"
                                                    Style="{DynamicResource EmilHeaderButton}" Height="24" Padding="8,0" Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋 " FontSize="10"/>
                                                    <TextBlock Text="Copy" FontSize="10" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🌐 Internet ID (Anywhere in world):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrandSkyTextBrush}"/>
                                                <TextBlock Text="{Binding InternetAddress}" FontFamily="Consolas, Cascadia Code" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrandSkyTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- One-Click Enable Internet Remoting Button (When Inactive) -->
                                    <Button Command="{Binding ToggleCloudflareTunnelCommand}"
                                            Visibility="{Binding IsCloudflareTunnelActive, Converter={x:Static vm:BooleanToInverseVisibilityConverter.Instance}}"
                                            Style="{DynamicResource EmilHeaderButton}" Height="28" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☁️ Enable Internet Remoting (Cloudflare)" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AnyDesk is ready for incoming connections." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding AutoAcceptIncoming}" Content="Auto-accept incoming connections" 
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBlock Text="Discovered Wi-Fi devices connect automatically in 1 click. To connect over the internet, click ☁️ Internet Tunnel." 
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Right Card: Remote Desk (AnyDesk Signature) -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                <TextBlock Text="🌐" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Remote Desk" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Control Partner" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="Please enter the address of the remote device you'd like to see." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    
                                    <!-- Partner Address Input & AnyDesk Red Connect Button -->
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding TargetHostId, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="17" FontWeight="Bold"
                                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" 
                                                     VerticalContentAlignment="Center" Height="38" Padding="10,0">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding ConnectRemoteCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding ConnectRemoteCommand}" 
                                                    Style="{DynamicResource AnyDeskRedButton}" Height="38" Padding="18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="➔ " FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="Connect" FontWeight="Bold" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Direct P2P • Auto Wi-Fi Discovery" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Command="{Binding ToggleAddressBookCommand}" 
                                                Style="{DynamicResource EmilHeaderButton}" Content="📖 Address Book" Height="22" Padding="8,0" FontSize="10"/>
                                    </DockPanel>
                                    <TextBlock Text="Enter partner ID (e.g. 579-591) for Wi-Fi, or Internet ID (e.g. 579-591@xyz.trycloudflare.com)." 
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Sessions Section (AnyDesk Style) -->
                        <Border Background="{DynamicResource CardSecondaryBgBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🕒 Recent Sessions" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AddressBookEntries.Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Recent Items Wrap List -->
                                <ItemsControl ItemsSource="{Binding AddressBookEntries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,10,10" Width="185">
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.ConnectToAddressBookEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Content="➔" Style="{DynamicResource AnyDeskRedButton}" Height="28" Width="30" Padding="0" ToolTip="Connect to this device"/>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Alias}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrandSkyTextBrush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when no recent sessions exist -->
                                <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,2,0,0">
                                    <TextBlock Text="Recent sessions will appear here automatically. Type a partner ID above and click Connect to start." 
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Floating Stats HUD Overlay (Top Right) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Margin="18" Background="#E60D0D11" BorderBrush="#24242E" BorderThickness="1" 
                        CornerRadius="10" Padding="14,12"
                        Visibility="{Binding IsSessionActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">
                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                            <TextBlock Text="TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ResolutionText}" Foreground="#A1A1AA" FontSize="10" FontFamily="Consolas, Cascadia Code"/>
                        </DockPanel>
                        
                        <!-- Badges Row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{Binding SecurityStatusColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SecurityStatusBadge}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                            </Border>

                            <Border Background="{Binding ConnectionPathColor}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ConnectionPathBadge}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                            </Border>

                            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding FpsText}" FontWeight="Bold" Foreground="#34D399" FontSize="12" FontFamily="Consolas, Cascadia Code"/>
                            </Border>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding LatencyText}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" FontFamily="Consolas, Cascadia Code"/>
                            </Border>
                            <Border Background="#4C1D95" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding BitrateText}" FontWeight="Bold" Foreground="#C084FC" FontSize="12" FontFamily="Consolas, Cascadia Code"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Permissions: " Foreground="#71717A" FontSize="11"/>
                            <TextBlock Text="{Binding GrantedPermissionsText}" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Timings: " Foreground="#71717A" FontSize="11"/>
                            <TextBlock Text="{Binding EncodeDecodeText}" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Code"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- In-Session Chat Side Panel -->
            <Border Grid.Column="1" Width="320" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsChatPaneOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" Padding="14,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleChatPaneCommand}" 
                                    Content="✕" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                            <TextBlock Text="💬 In-Session Chat" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Chat Message List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel Orientation="Vertical">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimestampUtc, StringFormat='{}{0:HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding SenderName}" FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chat Input Box & Send Button -->
                    <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" Padding="10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8,5" FontSize="12" Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendChatMessageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Command="{Binding SendChatMessageCommand}" 
                                    Content="Send" Style="{DynamicResource EmilAccentButton}" Height="28" Padding="12,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Remote Terminal Drawer (Collapsible bottom/overlay panel) -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                    Height="350" VerticalAlignment="Bottom"
                    Visibility="{Binding IsTerminalOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="-2" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal Header -->
                    <Border Grid.Row="0" Background="{DynamicResource InsetBgBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding ClearTerminalOutputCommand}" 
                                        Content="Clear" Style="{DynamicResource EmilHeaderButton}" Height="26" Padding="8,0" Margin="0,0,6,0"/>
                                <Button Command="{Binding ToggleTerminalPaneCommand}" 
                                        Content="✕" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💻 Remote Terminal (Windows ConPTY)" FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}" FontSize="13" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                
                                <TextBlock Text="Shell:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding AvailableShells}" 
                                          SelectedItem="{Binding SelectedShellType}" 
                                          Width="110" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>

                                <Button Command="{Binding StartTerminalSessionCommand}" 
                                        Content="▶ Start" Style="{DynamicResource EmilConnectButton}" Height="26" Padding="10,0" Margin="0,0,6,0"/>
                                <Button Command="{Binding CloseTerminalSessionCommand}" 
                                        Content="⏹ Stop" Style="{DynamicResource AnyDeskRedButton}" Height="26" Padding="10,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Terminal Output Screen -->
                    <ScrollViewer Grid.Row="1" Background="#090D16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding TerminalOutputText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 Background="Transparent" 
                                 Foreground="#38BDF8" 
                                 FontFamily="Cascadia Code, Consolas" 
                                 FontSize="13" 
                                 BorderThickness="0" 
                                 Padding="12" 
                                 TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- Terminal Input Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource InsetBgBrush}" Padding="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PS &gt; " Foreground="#10B981" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="6,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TerminalInputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" FontFamily="Cascadia Code, Consolas" FontSize="13" Padding="8,4" Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendTerminalInputCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Command="{Binding SendTerminalInputCommand}" 
                                    Content="Enter" Style="{DynamicResource EmilAccentButton}" Height="28" Padding="14,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Address Book Overlay Drawer -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalBackdropBrush}" 
                    Visibility="{Binding IsAddressBookOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="520" Height="500" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="2" Color="#000000" Opacity="0.2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleAddressBookCommand}" 
                                    Content="✕" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <TextBlock Text="📖 Saved PCs &amp; Address Book" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- List of Entries -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AddressBookEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ToggleFavoriteAddressBookCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding DeviceId}"
                                                            Content="⭐" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                                    <Button Command="{Binding DataContext.SelectAddressBookEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="Select" Style="{DynamicResource EmilConnectButton}" Height="26" Padding="10,0" Margin="0,0,6,0"/>
                                                    <Button Command="{Binding DataContext.DeleteAddressBookEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding DeviceId}"
                                                            Content="🗑️" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Alias}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DeviceId}" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource BrandSkyTextBrush}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LastConnectedUtc, StringFormat='Last connected: {0:yyyy-MM-dd HH:mm}'}" 
                                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer -->
                        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding SaveCurrentHostToAddressBookCommand}" 
                                    Content="+ Save Current Host ID" Style="{DynamicResource EmilAccentButton}" Height="30" Padding="14,0"/>
                            <TextBlock Text="{Binding AddressBookEntries.Count, StringFormat='Total saved: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- Fleet Dashboard Overlay Drawer -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource ModalBackdropBrush}" 
                    Visibility="{Binding IsFleetDashboardOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Width="1000" Height="660" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" ShadowDepth="2" Color="#000000" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Command="{Binding ToggleFleetDashboardCommand}" 
                                    Content="✕" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                            <Button DockPanel.Dock="Right" Command="{Binding OpenWebDashboardCommand}" 
                                    Content="🌐 Open in Browser" Style="{DynamicResource EmilAccentButton}" Height="28" Padding="10,0" Margin="0,0,12,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏢 Fleet Management &amp; Inventory" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Background="{DynamicResource BrandSkyBgBrush}" BorderBrush="{DynamicResource BrandSkyBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="Live Telemetry" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <!-- Metric Summary Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Total Hosts" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FleetSummary.TotalDevices}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BrandEmeraldBgBrush}" BorderBrush="{DynamicResource BrandEmeraldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="🟢 Online" FontSize="11" Foreground="{DynamicResource BrandEmeraldTextBrush}"/>
                                    <TextBlock Text="{Binding FleetSummary.OnlineDevices}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandEmeraldTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BrandSkyBgBrush}" BorderBrush="{DynamicResource BrandSkyBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="🔵 In Session" FontSize="11" Foreground="{DynamicResource BrandSkyTextBrush}"/>
                                    <TextBlock Text="{Binding FleetSummary.InSessionDevices}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandSkyTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="⚪ Offline" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FleetSummary.OfflineDevices}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Search & Filter Controls -->
                        <Border Grid.Row="2" Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="All" 
                                            Content="All" Style="{DynamicResource EmilHeaderButton}" Height="26" Padding="10,0" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="Online" 
                                            Content="Online" Style="{DynamicResource EmilConnectButton}" Height="26" Padding="10,0" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="InSession" 
                                            Content="In Session" Style="{DynamicResource EmilAccentButton}" Height="26" Padding="10,0" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SetFleetFilterCommand}" CommandParameter="Offline" 
                                            Content="Offline" Style="{DynamicResource EmilHeaderButton}" Height="26" Padding="10,0" Margin="0,0,8,0"/>
                                    <Button Command="{Binding RefreshFleetDataCommand}" 
                                            Content="🔄 Refresh" Style="{DynamicResource EmilAccentButton}" Height="26" Padding="12,0"/>
                                </StackPanel>

                                <TextBox Text="{Binding FleetSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="8,4" FontSize="12" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Border>

                        <!-- Devices Table -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FleetDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <DockPanel LastChildFill="True">
                                                <!-- Action Buttons on Right -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ConnectToFleetDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="⚡ Connect" Style="{DynamicResource EmilConnectButton}" Height="26" Padding="10,0" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.LaunchFleetDeviceTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="💻 Terminal" Style="{DynamicResource EmilHeaderButton}" Height="26" Padding="10,0" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.SendFleetLockCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="🔒 Lock" Style="{DynamicResource EmilHeaderButton}" Height="26" Padding="8,0" Margin="0,0,4,0"/>
                                                    <Button Command="{Binding DataContext.SendFleetRebootCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Content="🔄 Reboot" Style="{DynamicResource AnyDeskRedButton}" Height="26" Padding="8,0"/>
                                                </StackPanel>

                                                <!-- Device Details on Left -->
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Hostname}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding DeviceId}" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource BrandSkyTextBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding IpAddress}" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding OperatingSystem}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding MemoryDisplay, StringFormat='RAM: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding CpuModel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding LastHeartbeatUtc, StringFormat='Last seen: {0:HH:mm:ss}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer -->
                        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
                            <TextBlock Text="{Binding FleetDevices.Count, StringFormat='Total devices matching filter: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="7" Background="{DynamicResource StatusBarBgBrush}" Padding="14,6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InsetBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ServerStatusBadge}" Foreground="{Binding ServerStatusColor}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Command="{Binding OpenWebDashboardCommand}" 
                            Content="🌐 Web Dashboard" 
                            Style="{DynamicResource EmilHeaderButton}" Height="24" Padding="8,0" FontSize="11"
                            ToolTip="Open live Web Fleet Dashboard in default browser (http://localhost:5001/dashboard)"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
