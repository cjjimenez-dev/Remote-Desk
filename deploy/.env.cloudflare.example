# Cloudflare Tunnel Configuration for RemoteDesk
# Copy to .env.cloudflare and fill in your values

# Your chosen tunnel name (used in subdomain: yourname.trycloudflare.com)
TUNNEL_NAME=remotedesk

# Strong shared secret for TURN authentication (generate with: openssl rand -base64 32)
TURN_SECRET=your-super-secret-turn-key-change-this-2026

# Optional: Your public IP (helps coturn with external IP detection)
# Get it with: curl ifconfig.me
EXTERNAL_IP=auto