# ==============================================================================
# RemoteDesk VPS Deployment Configuration (.env)
# ==============================================================================

# Your server's public IP address (run `curl ifconfig.me` on the VPS to get it)
EXTERNAL_IP=203.0.113.10

# Domain name pointing to this VPS via Cloudflare DNS (Grey Cloud / DNS-only recommended for TURN)
# e.g. relay.yourdomain.com
DOMAIN=relay.yourdomain.com

# Strong shared secret for WebRTC HMAC-SHA1 TURN credentials
# Generate with: openssl rand -hex 32
TURN_SECRET=change-this-to-a-secure-random-32-byte-hex-string-2026

# Signaling Server Port (HTTP: 5000)
SIGNALING_PORT=5000

# TURN Ports
TURN_PORT=3478
TURNS_PORT=5349
TURN_FALLBACK_PORT=443
